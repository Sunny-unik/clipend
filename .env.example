# Clipend sync backend (Supabase)
#
# Vite auto-loads .env.development for `bun run dev` / `tauri dev`, and
# .env.production for `bun run build` / `tauri build`. Copy this file into
# BOTH of those paths and point each at a separate Supabase project so
# experimenting in dev never touches your production data:
#
#   cp .env.example .env.development   # dev Supabase project
#   cp .env.example .env.production    # prod Supabase project
#
# Local SQLite is already split the same way (clipend-dev.db / clipend.db),
# see src/lib/env.ts.
#
# Both values come from Supabase: Project Settings → API. The anon key is
# a public client key — safe to embed in the binary; RLS policies in
# supabase/schema.sql protect each user's rows.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Google Drive OAuth client for per-user file sync.
#
# Each user grants Clipend access to their own Drive (their files,
# their quota — never yours). One-time setup as the developer:
#   1. Google Cloud Console → New project (or reuse).
#   2. APIs & Services → Library → enable Google Drive API.
#   3. APIs & Services → OAuth consent screen → External; add
#      yourself + early testers as test users.
#   4. APIs & Services → Credentials → Create OAuth client →
#      "Desktop application" → name it "Clipend".
#   5. Copy BOTH the Client ID and Client Secret into the vars below.
#
# Note on the secret: Google's "Desktop application" client type
# requires the client_secret in the token exchange even though the
# flow uses PKCE. Google explicitly classifies this secret as
# non-confidential for desktop apps — it gets distributed to every
# user's machine inside the binary. PKCE is what actually protects
# the auth code; the secret is just a public app identifier here.
VITE_GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
