# Clipend sync backend (Supabase)
# Copy to `.env` and fill in the values from your Supabase project
# (Project Settings → API). Both are safe to commit into the compiled binary
# (the anon key is a public client key; row-level-security protects data).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
